PORT=5000

# MongoDB Atlas connection string
MONGO_URI=your_mongodb_connection_string_here

# Secret used to sign JWTs - use a long random string
JWT_SECRET=your_jwt_secret_here

# Frontend origin(s) allowed for CORS + Socket.io.
# Comma-separated - browsers treat localhost and 127.0.0.1 as different
# origins, and production often needs both an apex and a www domain.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Optional: SMTP settings for sending "forgot password" reset emails.
# If left unset, reset links are printed to the server console instead
# of actually emailed - handy for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CampusLink <no-reply@campuslink.app>"
