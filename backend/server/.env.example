PORT=5000

# MongoDB Atlas connection string
MONGO_URI=your_mongodb_connection_string_here

# Secret used to sign JWTs - use a long random string
JWT_SECRET=your_jwt_secret_here

# Frontend origin allowed to connect via Socket.io (CORS)
CLIENT_URL=http://localhost:5173

# Optional: SMTP settings for sending "forgot password" reset emails.
# If left unset, reset links are printed to the server console instead
# of actually emailed - handy for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CampusLink <no-reply@campuslink.app>"
